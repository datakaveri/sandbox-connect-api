                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Terminate Booking Session",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/bookings/{{booking_id}}/terminate",
              "host": [
