{
  "info": {
    "name": "Sandbox Connect API",
    "_postman_id": "3c2f9028-1d6e-4e06-b3d8-sandbox-connect-api",
    "description": "Postman collection for Sandbox Connect API. Set `base_url` and `access_token` in the matching environment before running authenticated requests. Most `/v1/*` API routes require `Authorization: Bearer {{access_token}}`; health and API docs routes are public.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "{{base_url}}"
    },
    {
      "key": "access_token",
      "value": "{{access_token}}"
    }
  ],
