    {
      "name": "Bookings",
      "description": "Create, list, cancel, extend, reset, and terminate sandbox bookings.",
      "item": [
        {
          "name": "List Bookings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/bookings?status={{status_filter}}&limit={{limit}}&offset={{offset}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "bookings"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "{{status_filter}}",
                  "description": "Comma-separated states, or all."
                },
                {
                  "key": "limit",
                  "value": "{{limit}}",
                  "description": "Max rows, default 10 and max 50."
                },
                {
                  "key": "offset",
                  "value": "{{offset}}",
                  "description": "Pagination offset."
                }
              ]
            },
            "description": "Lists CPU and GPU slot bookings for the current user."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.expect([200]).to.include(pm.response.code);",
                  "});",
                  "const data = pm.response.json();",
                  "if (Array.isArray(data.bookings) && data.bookings.length > 0) {",
                  "    pm.environment.set(\"booking_id\", String(data.bookings[0].id));",
                  "    if (data.bookings[0].notebookName) pm.environment.set(\"notebook_name\", data.bookings[0].notebookName);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/bookings",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "bookings"
              ]
            },
            "description": "Creates a CPU or GPU booking from category and slot selection.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notebookName\": \"{{notebook_name}}\",\n  \"category\": \"{{category}}\",\n  \"slotDate\": \"{{slot_date}}\",\n  \"slotKeys\": [\n    \"{{slot_key}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.expect([201]).to.include(pm.response.code);",
                  "});",
                  "pm.test(\"Response has bookingId\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.have.property(\"bookingId\");",
                  "});",
                  "const created = pm.response.json();",
                  "if (created.bookingId) pm.environment.set(\"booking_id\", String(created.bookingId));",
                  "if (created.notebookName) pm.environment.set(\"notebook_name\", created.notebookName);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel Scheduled Booking",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/bookings/{{booking_id}}/cancel",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "bookings",
                "{{booking_id}}",
                "cancel"
              ]
            },
            "description": "Cancels a scheduled booking before resources are ready."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200, 400, 404\", function () {",
                  "    pm.expect([200, 400, 404]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Extend Active Booking",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/bookings/{{booking_id}}/extend",
