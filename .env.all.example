# ===========================================
# API SERVER CONFIGURATION
# ===========================================

# Server Configuration
API_ADDRESS=0.0.0.0:3000
API_VERSION=v1
API_LOG_LEVEL=info

# Database Configuration
API_POSTGRES_URL=postgresql://username:password@localhost:5432/sandbox_db

# Kubernetes Configuration
API_KUBE_CONFIG_MODE=cluster
API_KUBE_CONFIG_PATH=

# Keycloak Authentication
API_KEYCLOAK_URL=https://idp.example.com/auth
API_KEYCLOAK_REALM=your-realm
API_KEYCLOAK_CLIENT_ID=your-client-id
API_KEYCLOAK_PUBLIC_KEY=MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...

# CORS Configuration
API_CORS_ORIGINS=*

# Rate Limiting
API_RATE_LIMIT=80
API_RATE_WINDOW_SECS=30

# Server Timeouts
API_TIMEOUT_SECS=60
API_IDLE_TIMEOUT_SECS=120
API_READ_TIMEOUT_SECS=30
API_WRITE_TIMEOUT_SECS=60

# Request Configuration
API_MAX_BODY_SIZE_IN_MB=5

# Notebook Default Configuration - CPU
API_DEFAULT_CPU_STORAGE_SIZE=10Gi
API_DEFAULT_CPU_REQUEST=1.25
API_DEFAULT_CPU_LIMIT=1.5
API_DEFAULT_MEMORY_REQUEST=3.5Gi
API_DEFAULT_MEMORY_LIMIT=4Gi

# Notebook Default Configuration - GPU
API_DEFAULT_GPU_STORAGE_SIZE=50Gi
API_DEFAULT_GPU_TYPE=nvidia.com/gpu
API_DEFAULT_GPU_REQUEST=1
API_DEFAULT_GPU_LIMIT=1
API_DEFAULT_GPU_CPU_REQUEST=3
API_DEFAULT_GPU_CPU_LIMIT=3.9
API_DEFAULT_GPU_MEMORY_REQUEST=12Gi
API_DEFAULT_GPU_MEMORY_LIMIT=14Gi

# Notebook Limits
API_MAX_RUNNING_CPU=1
API_MAX_RUNNING_GPU=1
API_MAX_TOTAL_CPU=6
API_MAX_TOTAL_GPU=4

# KubeFlow Configuration
API_KUBEFLOW_URL=https://sandbox.example.com
API_NOTEBOOK_LIST_LIMIT=10

# ECR Configuration (for image pull secret creation)
# Default: API_CREATE_ECR_SECRET=false
# Set API_CREATE_ECR_SECRET to true to enable ECR image pull secret generation
API_CREATE_ECR_SECRET=false
# The following are required only if API_CREATE_ECR_SECRET is true
API_ECR_REGION=us-east-1
API_ECR_REGISTRY_URL=123456789012.dkr.ecr.us-east-1.amazonaws.com
API_AWS_ACCESS_KEY_ID=your-access-key-id
API_AWS_SECRET_KEY=your-secret-key
API_ECR_SECRET_NAME=ecr-registry-cred

# ===========================================
# WORKER CONFIGURATION
# ===========================================

# Database Configuration
WORKER_POSTGRES_URL=postgresql://username:password@localhost:5432/sandbox_db

# Kubernetes Configuration
WORKER_KUBE_CONFIG_MODE=cluster
WORKER_KUBE_CONFIG_PATH=

# Worker Configuration
WORKER_MAX_CONCURRENT_WORKER=5

# S3 Configuration
WORKER_S3_ENDPOINT=https://s3.example.com
WORKER_S3_REGION=us-east-1
WORKER_S3_ACCESS_KEY=your-access-key
WORKER_S3_SECRET_KEY=your-secret-key
WORKER_S3_TEMPLATE_BUCKET_NAME=notebook-templates

# Storage Configuration
WORKER_STORAGE_CLASS_NAME=ebs-csi-storage-class

# images
WORKER_CPU_NOTEBOOK_IMAGE="108779579607.dkr.ecr.ap-south-1.amazonaws.com/tgdex/ai-sandbox-cpu-notebook:latest"
WORKER_GPU_NOTEBOOK_IMAGE="108779579607.dkr.ecr.ap-south-1.amazonaws.com/tgdex/ai-sandbox-gpu-notebook:latest"
WORKER_INIT_CONTAINER_IMAGE="108779579607.dkr.ecr.ap-south-1.amazonaws.com/tgdex/demo-notebook-file:latest"
WORKER_GPU_NODE_INSTANCE_TYPE=g4dn.xlarge
WORKER_CPU_NODE_INSTANCE_TYPES=t3a.2xlarge,c5a.4xlarge

# Image Pull Configuration
# Default: WORKER_IMAGE_PULL_ENABLED=false
# Set WORKER_IMAGE_PULL_ENABLED to true to use image pull secrets
# WORKER_ECR_SECRET_NAME is required only when WORKER_IMAGE_PULL_ENABLED is true
WORKER_IMAGE_PULL_ENABLED=false
WORKER_ECR_SECRET_NAME=ecr-registry-cred

# ===========================================
# CRON JOB CONFIGURATION (Profile Credit Sync)
# ===========================================

# Database Configuration
PROFILE_CREDIT_SYNC_POSTGRES_URL=postgresql://username:password@localhost:5432/sandbox_db

# External APIs
PROFILE_CREDIT_SYNC_OPENCOST_URL=http://opencost.opencost:9003
PROFILE_CREDIT_SYNC_AAA_URL=https://dx.example.com

# Keycloak Configuration
PROFILE_CREDIT_SYNC_KEYCLOAK_URL=https://idp.example.com/auth
PROFILE_CREDIT_SYNC_KEYCLOAK_REALM=your-realm
PROFILE_CREDIT_SYNC_KEYCLOAK_CLIENT_ID=your-client-id
PROFILE_CREDIT_SYNC_KEYCLOAK_USERNAME=service-account-username
PROFILE_CREDIT_SYNC_KEYCLOAK_PASSWORD=service-account-password

# Kubernetes Configuration
PROFILE_CREDIT_SYNC_K8S_CONFIG_MODE=cluster
PROFILE_CREDIT_SYNC_K8S_CONFIG_PATH=

# Sync Configuration
PROFILE_CREDIT_SYNC_MAX_PROFILE_CAN_SYNC_AT_ONCE=50
PROFILE_CREDIT_SYNC_GPU_RESOURCE_KEYS=nvidia.com/gpu
PROFILE_CREDIT_SYNC_LOG_LEVEL=info

