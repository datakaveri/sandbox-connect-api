# Combined Environment Variables for API and Worker Services

###################
# Common Variables
###################

# Database connection string
POSTGRES_URL="postgresql://postgres:password@localhost:5432/postgres"

# Kubernetes configuration
KUBE_CONFIG_PATH="/home/user/.kube/config"
KUBE_CONFIG_MODE="local" # Options: local, cluster

###################
# API Variables
###################

# Server address
ADDRESS="0.0.0.0:3000"

###################
# Worker Variables
###################

# Worker configuration
MAX_CONCURRENT_WORKER=5

# S3 configuration
S3_ENDPOINT="https://s3.amazonaws.com"
S3_REGION="ap-south-1"
S3_ACCESS_KEY="YOUR_ACCESS_KEY"
S3_SECRET_KEY="YOUR_SECRET_KEY"
S3_TEMPLATE_BUCKET_NAME="your-template-bucket"

# Default values for notebook creation
DEFAULT_USER_ID="test-user"
DEFAULT_NAMESPACE="test-user"
DEFAULT_STORAGE_SIZE="10Gi"
DEFAULT_CPU_REQUEST="1"
DEFAULT_CPU_LIMIT="2"
DEFAULT_MEMORY_REQUEST="2Gi"
DEFAULT_MEMORY_LIMIT= "4Gi"
DEFAULT_GPU_TYPE= "nvidia"
DEFAULT_GPU_LIMIT= "1"
