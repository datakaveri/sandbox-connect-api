# =============================================================================
# Sandbox Connect API — example environment for all components
# =============================================================================
#
# Field-by-field documentation lives in docs/config/. Every variable below is
# read by code; the authoritative schema is the `env:"..."` struct tags in
# cmd/*/types.go.
#
# Values shown are examples, not defaults. Placeholders in <angle-brackets>
# must be replaced. Never commit real credentials to this file.
#
# In Kubernetes these come from ConfigMaps and Secrets (see infra/), not from a
# .env file. This file is the reference for local runs and for knowing which
# keys exist.

# =============================================================================
# API SERVER                                                  docs/config/api.md
# =============================================================================

# --- Server ---
API_ADDRESS=0.0.0.0:3000
API_VERSION=v1
# Only the exact string "debug" lowers the level; anything else means info.
API_LOG_LEVEL=info

# --- Kubernetes ---
# cluster = in-cluster service account (use this in any deployment)
# local   = external kubeconfig, developer laptops only
API_KUBE_CONFIG_MODE=cluster
API_KUBE_CONFIG_PATH=

# --- Database ---
# In-cluster this is projected from Secret database-creds, key POSTGRES_URL.
# Must be the same database as the worker and both crons.
API_POSTGRES_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require

# --- JupyterLite static assets ---
# Base URL is a path prefix, not a URL. The static dir default is relative, so
# set it explicitly — the image copies the bundle to /app/jupyterlite.
API_JUPYTERLITE_BASE_URL=/jupyterlite
API_JUPYTERLITE_STATIC_DIR=/app/jupyterlite

# --- Keycloak (token validation) ---
# Include /auth only if the Keycloak deployment uses that context path.
API_KEYCLOAK_URL=https://idp.example.com/auth
API_KEYCLOAK_REALM=<realm>
# The PUBLIC (browser) client the frontend authenticates with.
API_KEYCLOAK_CLIENT_ID=<frontend-client-id>
# Realm RS256 public key: base64 DER only, no PEM headers, no newlines.
# Realm settings -> Keys -> RS256 -> Public key. Rotating the realm key
# without updating this takes the API down.
API_KEYCLOAK_PUBLIC_KEY=MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...

# --- Platform token exchange (notebook delegation) ---
# A CONFIDENTIAL client, distinct from API_KEYCLOAK_CLIENT_ID, with token
# exchange enabled. See docs/config/api.md section 3.
API_PLATFORM_TOKEN_EXCHANGE_CLIENT_ID=sandbox-notebook
API_PLATFORM_TOKEN_EXCHANGE_CLIENT_SECRET=<notebook-exchange-client-secret>
API_PLATFORM_TOKEN_NOTEBOOK_CLIENT_ID=sandbox-notebook
# Leave empty to derive from API_KEYCLOAK_URL + realm (preferred — it cannot
# then drift from the realm settings).
API_PLATFORM_TOKEN_EXCHANGE_TOKEN_URL=
API_PLATFORM_TOKEN_EXCHANGE_SCOPE=openid profile email
API_PLATFORM_TOKEN_EXCHANGE_AUDIENCE=
# Must match READY_ADDRESS and containerPort in the worker notebook templates.
API_PLATFORM_TOKEN_READY_PORT=8081
API_PLATFORM_TOKEN_READY_TIMEOUT_SECS=40

# --- CORS ---
# Comma-separated origins, no trailing slash. "*" is acceptable only while auth
# is bearer-token based; it is unsafe if cookie auth is ever introduced.
API_CORS_ORIGINS=*

# --- Rate limiting ---
# WARNING: no defaults. Unset means 0, and 0 does not mean "unlimited":
#   API_RATE_LIMIT=0       -> only the first request per IP per window succeeds
#   API_RATE_WINDOW_SECS=0 -> rate limiting is silently disabled entirely
# Per-pod and in-memory, so the cluster-wide limit is this x replica count.
API_RATE_LIMIT=80
API_RATE_WINDOW_SECS=30

# --- Timeouts (seconds) ---
# WARNING: no defaults, and 0 means different things per field:
#   API_TIMEOUT_SECS=0  -> context already expired; EVERY request fails
#   the three http.Server timeouts at 0 -> no timeout at all
# Keep API_WRITE_TIMEOUT_SECS >= API_TIMEOUT_SECS.
API_TIMEOUT_SECS=60
API_IDLE_TIMEOUT_SECS=120
API_READ_TIMEOUT_SECS=30
API_WRITE_TIMEOUT_SECS=60

# --- Request limits ---
# 0 rejects every request that has a body, including small JSON POSTs.
API_MAX_BODY_SIZE_IN_MB=5

# --- Notebook defaults: CPU ---
# All required. Kubernetes quantity strings, validated only when a notebook is
# created — "4GB" instead of "4Gi" starts fine and fails later.
API_DEFAULT_CPU_STORAGE_SIZE=10Gi
API_DEFAULT_CPU_REQUEST=1.25
API_DEFAULT_CPU_LIMIT=1.5
API_DEFAULT_MEMORY_REQUEST=3.5Gi
API_DEFAULT_MEMORY_LIMIT=4Gi

# --- Notebook defaults: GPU ---
API_DEFAULT_GPU_STORAGE_SIZE=50Gi
API_DEFAULT_GPU_TYPE=nvidia.com/gpu
API_DEFAULT_GPU_REQUEST=1
API_DEFAULT_GPU_LIMIT=1
API_DEFAULT_GPU_CPU_REQUEST=3
API_DEFAULT_GPU_CPU_LIMIT=3.9
API_DEFAULT_GPU_MEMORY_REQUEST=12Gi
API_DEFAULT_GPU_MEMORY_LIMIT=14Gi

# --- Per-user quotas ---
# WARNING: no defaults. 0 blocks ALL notebook creation, because the checks are
# ">=" — the first attempt reports "limit exceeded (0/0 running)".
API_MAX_RUNNING_CPU=1
API_MAX_RUNNING_GPU=1
API_MAX_TOTAL_CPU=6
API_MAX_TOTAL_GPU=4

# --- Notebook placement and URLs ---
# Must match the node.kubernetes.io/instance-type labels actually present.
# On-prem clusters often use role words (gpu, aic) rather than cloud types.
API_GPU_NODE_INSTANCE_TYPES=g4dn.xlarge,p4d.24xlarge,p5.48xlarge
# Public, browser-reachable Kubeflow host — it is handed to users.
API_KUBEFLOW_URL=https://sandbox.example.com
# 0 makes the list endpoint return an empty page.
API_NOTEBOOK_LIST_LIMIT=10
# The file notebookUrl opens by default; must be created by the demo init
# image. Empty opens the JupyterLab file browser instead.
API_STARTUP_NOTEBOOK_FILENAME=demo.ipynb

# --- Feature flags ---
# Required, no default. Product/compliance decision.
API_KYC_ENABLED=true
# Requires SLOT_CONFIG_PROFILE and a running slot-lifecycle deployment;
# without it, bookings are accepted but never transition state.
API_BOOKINGS_ENABLED=true
# MUST be the inverse of spec.lifecycle.demoFiles.enabled in the worker
# notebook templates, or users land on a JupyterLab 404.
API_DISABLE_INIT=false
# Slot/category configuration selected at deploy time. Shared (unprefixed)
# with the slot-lifecycle component — the two MUST agree.
SLOT_CONFIG_PROFILE=production
# DEPRECATED: legacy alias, used only when SLOT_CONFIG_PROFILE is empty.
# Leave unset; remove once no environment sets it.
API_GPU_SLOT_CONFIG_PROFILE=

# --- Registry secret provisioning ---
# API_REGISTRY_SECRET_TYPE selects the flow and what else is required:
#   ecr              -> ECR_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_KEY, URL
#   private-registry -> USERNAME, PASSWORD, URL
#   none (default)   -> nothing; no pull secret is created
# The required set is enforced at first use, NOT at startup.
API_REGISTRY_SECRET_TYPE=ecr
# Host only — no scheme, no trailing slash.
API_REGISTRY_URL=<aws-account-id>.dkr.ecr.ap-south-1.amazonaws.com
# Must equal imagePullSecrets[].name in both notebook templates.
API_REGISTRY_SECRET_NAME=registry-cred
# --- when API_REGISTRY_SECRET_TYPE=ecr ---
API_REGISTRY_ECR_REGION=ap-south-1
API_REGISTRY_AWS_ACCESS_KEY_ID=<aws-access-key-id>
API_REGISTRY_AWS_SECRET_KEY=<aws-secret-access-key>
# --- when API_REGISTRY_SECRET_TYPE=private-registry ---
# Read-only pull credentials only: this secret is copied into every user
# namespace, so any push rights here are granted to all sandbox users.
API_REGISTRY_USERNAME=
API_REGISTRY_PASSWORD=

# =============================================================================
# WORKER                                                   docs/config/worker.md
# =============================================================================
#
# Note: notebook images, storage class, node instance types, the token sidecar
# image and the platform URLs are NOT environment variables. They live in the
# SandboxNotebookTemplate YAML in infra/worker/configmap.yaml. Fourteen
# WORKER_* variables that used to appear here were removed in July 2026 — they
# were read by no code.

# --- Notebook templates (required) ---
# Paths inside the mounted notebook-templates ConfigMap volume. Templates are
# read ONCE at startup: restart the worker after editing the ConfigMap.
WORKER_CPU_NOTEBOOK_TEMPLATE_PATH=/etc/sandbox-worker/templates/cpu-notebook-template.yaml
WORKER_GPU_NOTEBOOK_TEMPLATE_PATH=/etc/sandbox-worker/templates/gpu-notebook-template.yaml

# --- Database ---
# Same database as the API. A different one starts cleanly and silently never
# reconciles anything.
WORKER_POSTGRES_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require

# --- Kubernetes ---
WORKER_KUBE_CONFIG_MODE=cluster
WORKER_KUBE_CONFIG_PATH=

# --- Concurrency ---
# Required. Effective concurrency is this x replica count. 0 is accepted and
# the worker then processes nothing while looking healthy.
WORKER_MAX_CONCURRENT_WORKER=5

# --- S3 template storage (all required, from Secret s3-creds) ---
# Endpoint needs a scheme; region must match it or signing fails.
WORKER_S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
WORKER_S3_REGION=ap-south-1
WORKER_S3_ACCESS_KEY=<s3-access-key>
WORKER_S3_SECRET_KEY=<s3-secret-key>
# Bucket name only — no scheme, no s3:// prefix, no path.
WORKER_S3_TEMPLATE_BUCKET_NAME=notebook-templates

# =============================================================================
# SLOT LIFECYCLE                                   docs/config/slot-lifecycle.md
# =============================================================================
#
# Deployed as a long-running Deployment, not a CronJob.

SLOT_LIFECYCLE_POSTGRES_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require
SLOT_LIFECYCLE_K8S_CONFIG_MODE=cluster
SLOT_LIFECYCLE_K8S_CONFIG_PATH=
SLOT_LIFECYCLE_LOG_LEVEL=info
# Use json wherever logs are aggregated; text is a local-development choice.
SLOT_LIFECYCLE_LOG_FORMAT=json

# Pacing. These three interact: BATCH_SIZE must be processable within
# RUN_TIMEOUT_SECS, which should comfortably exceed TICK_INTERVAL_SECS.
# A tick interval of N means a booking can overrun by up to N seconds.
SLOT_LIFECYCLE_TICK_INTERVAL_SECS=5
SLOT_LIFECYCLE_RUN_TIMEOUT_SECS=45
SLOT_LIFECYCLE_BATCH_SIZE=50

# Shared with the API — the two MUST agree, or slots expire on different
# boundaries than the ones users were offered. Note this component defaults to
# "production" while the API defaults to empty; set it explicitly in both.
SLOT_CONFIG_PROFILE=production
# DEPRECATED: legacy alias, used only when SLOT_CONFIG_PROFILE is empty.
GPU_SLOT_CONFIG_PROFILE=

# =============================================================================
# PROFILE CREDIT SYNC                        docs/config/profile-credit-sync.md
# =============================================================================
#
# CronJob, every minute, concurrencyPolicy: Forbid. All eight fields below
# marked required must be set or every run exits 1.

PROFILE_CREDIT_SYNC_POSTGRES_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require

# In-cluster OpenCost allocation API — http, not https. Port 9003 is default.
PROFILE_CREDIT_SYNC_OPENCOST_URL=http://opencost.opencost:9003
# Platform AAA service holding the authoritative credit balance.
PROFILE_CREDIT_SYNC_AAA_URL=https://dx.example.com

# Keycloak service account (direct-grant/password flow).
# Must match the API's Keycloak URL and realm verbatim.
PROFILE_CREDIT_SYNC_KEYCLOAK_URL=https://idp.example.com/auth
PROFILE_CREDIT_SYNC_KEYCLOAK_REALM=<realm>
# Needs "Direct access grants" enabled on the client.
PROFILE_CREDIT_SYNC_KEYCLOAK_CLIENT_ID=<client-id>
# A dedicated service user, not a person's account. Must have no pending
# required actions, no temporary password, and exemption from password expiry
# — each of those breaks the grant with the same "invalid_grant" error.
PROFILE_CREDIT_SYNC_KEYCLOAK_USERNAME=<service-account-username>
PROFILE_CREDIT_SYNC_KEYCLOAK_PASSWORD=<service-account-password>

PROFILE_CREDIT_SYNC_K8S_CONFIG_MODE=cluster
PROFILE_CREDIT_SYNC_K8S_CONFIG_PATH=

# Which extended-resource keys count as GPU usage for billing. If empty or
# wrong, GPU usage silently bills as ZERO — no error is logged. Should match
# API_DEFAULT_GPU_TYPE. MIG and AMD resources are distinct keys.
PROFILE_CREDIT_SYNC_GPU_RESOURCE_KEYS=nvidia.com/gpu
PROFILE_CREDIT_SYNC_LOG_LEVEL=info

# =============================================================================
# RABBITMQ — audit publishing (API)                           docs/config/api.md
# =============================================================================
#
# Entirely optional. If RABBITMQ_HOST is empty, auditing is silently disabled.
# If it is set but wrong, requests still succeed and audit events are simply
# lost — so treat "no audit events" as a config problem first.
#
# Do NOT leave a placeholder in RABBITMQ_HOST in a deployment: a non-empty
# placeholder enables auditing and then fails DNS on every publish. Either set
# a real host or remove the key.
#
# RABBITMQ_HOST=rabbitmq.messaging.svc.cluster.local
# RABBITMQ_PORT=5672
# RABBITMQ_VHOST=/
# Publish-only credentials. Kubernetes Secret only, never a ConfigMap.
# RABBITMQ_USERNAME=<rabbitmq-username>
# RABBITMQ_PASSWORD=<rabbitmq-password>
# Exchange must already exist — the service does not declare it.
# RABBITMQ_EXCHANGE=auditing
# Must match the consumer's binding, or messages are dropped with no error.
# RABBITMQ_ROUTING_KEY=<routing-key>
# String, compared literally: "true" selects amqps (TLS). "True"/"1" do not.
# Set a TLS port (5671) alongside it.
# RABBITMQ_ONLY_FOR_MAHA_AGX=true

# =============================================================================
# PLATFORM TOKEN SIDECAR                 docs/config/platform-token-sidecar.md
# =============================================================================
#
# Not configured here. The sidecar runs inside each notebook pod and its
# environment is templated into containers[].env in both SandboxNotebookTemplate
# documents in infra/worker/configmap.yaml.
#
# It has NO required fields and no config struct — a missing variable yields an
# empty string and the sidecar starts anyway, so misconfiguration shows up as
# notebooks that never become ready rather than as a startup error.
